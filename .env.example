# Copy to .env and fill in locally. Never commit .env.
#
# Hugging Face token (only needed for gated datasets / private model snapshots).
# HF_TOKEN=
#
# Optional: name of a Modal Secret holding HF_TOKEN (used at image/decoration time).
# HF_SECRET_NAME=
#
# Cacheable H200 runs must set this to H200 exactly (no H100 fallback).
# ALLO_GPU_SPEC=H200
